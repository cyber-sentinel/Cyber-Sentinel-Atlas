{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-sentinel.net/schemas/pack/v1/source-license-inventory.schema.json",
  "title": "Atlas Source and License Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventory_version", "pack_id", "pack_version", "entries"],
  "properties": {
    "inventory_version": {"const": "1.0.0"},
    "pack_id": {
      "type": "string",
      "pattern": "^atlas:pack:[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "pack_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_name",
        "upstream_url",
        "source_version_or_commit",
        "content_digest",
        "redistribution_scope",
        "license_status",
        "license_identifier",
        "notice_required",
        "attribution",
        "evidence_url",
        "reviewed_at"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "source_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "upstream_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "source_version_or_commit": {"type": "string", "minLength": 1, "maxLength": 256},
        "content_digest": {"$ref": "#/$defs/digest"},
        "redistribution_scope": {"enum": ["included", "reference-only"]},
        "license_status": {
          "enum": [
            "verified-redistributable",
            "verified-reference-only",
            "unknown",
            "incompatible"
          ]
        },
        "license_identifier": {"type": "string", "minLength": 1, "maxLength": 256},
        "notice_required": {"type": "boolean"},
        "attribution": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
