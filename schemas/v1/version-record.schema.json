{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-sentinel.dev/schemas/v1/version-record.schema.json",
  "title": "VersionRecord",
  "allOf": [
    {"$ref": "https://cyber-sentinel.dev/schemas/v1/defs/common-metadata.schema.json"},
    {"type": "object", "required": ["record_kind", "namespace", "canonical_key", "subject_id", "version_type", "native_label", "version_scheme"], "properties": {
      "record_kind": {"const": "version"},
      "namespace": {"const": "atlas.version"},
      "canonical_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "subject_id": {"$ref": "https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"},
      "version_type": {"type": "string", "enum": ["platform", "product", "provider", "source", "schema"]},
      "native_label": {"type": "string", "minLength": 1},
      "normalized_value": {"type": ["string", "number", "integer"]},
      "version_scheme": {"type": "string", "enum": ["semver", "numeric", "date", "build", "opaque", "vendor-native"]},
      "release_date": {"type": "string", "format": "date"},
      "valid_from": {"type": "string", "format": "date-time"},
      "valid_to": {"type": "string", "format": "date-time"},
      "end_of_support": {"type": "string", "format": "date-time"},
      "evidence": {"type": "array", "items": {"$ref": "https://cyber-sentinel.dev/schemas/v1/defs/evidence.schema.json"}}
    }}
  ],
  "unevaluatedProperties": false
}