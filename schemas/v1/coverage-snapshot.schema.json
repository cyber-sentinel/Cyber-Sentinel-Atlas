{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-sentinel.dev/schemas/v1/coverage-snapshot.schema.json",
  "title": "CoverageSnapshot",
  "allOf": [
    {"$ref": "https://cyber-sentinel.dev/schemas/v1/defs/common-metadata.schema.json"},
    {"type": "object", "required": ["record_kind", "namespace", "canonical_key", "metric_type", "scope", "denominator_definition", "denominator_count", "state_counts", "source_inventory_version", "content_version", "content_schema_version", "measured_at", "validation_status"], "properties": {
      "record_kind": {"const": "coverage-snapshot"},
      "namespace": {"const": "atlas.coverage"},
      "canonical_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "metric_type": {"type": "string", "enum": ["telemetry", "detection"]},
      "scope": {"type": "object", "additionalProperties": false, "required": ["description"], "properties": {"description": {"type": "string", "minLength": 1}, "entity_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"}}, "namespace": {"type": "string"}}},
      "denominator_definition": {"type": "string", "minLength": 1},
      "denominator_count": {"type": "integer", "minimum": 1},
      "state_counts": {"type": "object", "additionalProperties": false, "properties": {"expected": {"type": "integer", "minimum": 0}, "collected": {"type": "integer", "minimum": 0}, "normalized": {"type": "integer", "minimum": 0}, "validated": {"type": "integer", "minimum": 0}, "published": {"type": "integer", "minimum": 0}, "missing": {"type": "integer", "minimum": 0}, "invalid": {"type": "integer", "minimum": 0}, "covered": {"type": "integer", "minimum": 0}, "uncovered": {"type": "integer", "minimum": 0}}, "minProperties": 1},
      "source_inventory_version": {"type": "string", "minLength": 1},
      "content_version": {"type": "string", "minLength": 1},
      "content_schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "measured_at": {"type": "string", "format": "date-time"},
      "validation_status": {"type": "string", "enum": ["draft", "review", "validated", "published"]}
    }}
  ],
  "unevaluatedProperties": false
}