{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cyber-sentinel.dev/schemas/v1/coverage-snapshot.schema.json",
  "title":"CoverageSnapshot",
  "allOf":[
    {"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/common-metadata.schema.json"},
    {"type":"object","required":["record_kind","namespace","canonical_key","metric_type","scope","denominator_definition","denominator_count","numerator_count","state_counts","inventory_version","content_version","content_schema_version","measured_at","validation_status"],"properties":{
      "record_kind":{"const":"coverage-snapshot"},
      "namespace":{"type":"string","const":"atlas.coverage"},
      "canonical_key":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
      "metric_type":{"type":"string","enum":["telemetry","detection"]},
      "scope":{"type":"object","additionalProperties":false,"minProperties":1,"properties":{"subject_ids":{"type":"array","items":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"},"uniqueItems":true},"namespace":{"type":"string","pattern":"^[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"},"description":{"type":"string","minLength":1}}},
      "denominator_definition":{"type":"string","minLength":1},
      "denominator_count":{"type":"integer","minimum":0},
      "numerator_count":{"type":"integer","minimum":0},
      "state_counts":{"type":"object"},
      "inventory_version":{"type":"string","minLength":1},
      "content_version":{"type":"string","minLength":1},
      "content_schema_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "measured_at":{"type":"string","format":"date-time"},
      "validation_status":{"type":"string","enum":["unvalidated","validated","invalid"]}
    },
    "allOf":[
      {"if":{"properties":{"metric_type":{"const":"telemetry"}}},"then":{"properties":{"state_counts":{"type":"object","additionalProperties":false,"required":["expected","collected","normalized","validated","published","missing","invalid"],"properties":{"expected":{"type":"integer","minimum":0},"collected":{"type":"integer","minimum":0},"normalized":{"type":"integer","minimum":0},"validated":{"type":"integer","minimum":0},"published":{"type":"integer","minimum":0},"missing":{"type":"integer","minimum":0},"invalid":{"type":"integer","minimum":0}}}}}},
      {"if":{"properties":{"metric_type":{"const":"detection"}}},"then":{"properties":{"state_counts":{"type":"object","additionalProperties":false,"required":["in_scope","covered","uncovered","validated","unvalidated"],"properties":{"in_scope":{"type":"integer","minimum":0},"covered":{"type":"integer","minimum":0},"uncovered":{"type":"integer","minimum":0},"validated":{"type":"integer","minimum":0},"unvalidated":{"type":"integer","minimum":0}}}}}}
    ]}
  ],
  "unevaluatedProperties":false
}
