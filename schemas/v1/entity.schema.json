{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cyber-sentinel.dev/schemas/v1/entity.schema.json",
  "title":"EntityRecord",
  "allOf":[
    {"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/common-metadata.schema.json"},
    {"type":"object","required":["record_kind","entity_type","namespace","canonical_key","title"],"properties":{
      "record_kind":{"const":"entity"},
      "entity_type":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
      "namespace":{"type":"string","pattern":"^[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"},
      "canonical_key":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
      "title":{"type":"string","minLength":1},
      "localized_titles":{"type":"object","patternProperties":{"^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$":{"type":"string","minLength":1}},"additionalProperties":false},
      "native_identifiers":{"type":"array","items":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/native-identifier.schema.json"},"uniqueItems":true},
      "aliases":{"type":"array","items":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/alias.schema.json"}},
      "lifecycle":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/lifecycle.schema.json"},
      "applicability":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/applicability.schema.json"}
    }}
  ],
  "unevaluatedProperties":false
}
