{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-sentinel.dev/schemas/v1/defs/claim-object.schema.json",
  "title": "Claim Object",
  "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["kind", "entity_id"], "properties": {"kind": {"const": "entity-ref"}, "entity_id": {"$ref": "https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "datatype", "value"], "properties": {"kind": {"const": "literal"}, "datatype": {"const": "string"}, "value": {"type": "string"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "datatype", "value"], "properties": {"kind": {"const": "literal"}, "datatype": {"const": "integer"}, "value": {"type": "integer"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "datatype", "value"], "properties": {"kind": {"const": "literal"}, "datatype": {"const": "number"}, "value": {"type": "number"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "datatype", "value"], "properties": {"kind": {"const": "literal"}, "datatype": {"const": "boolean"}, "value": {"type": "boolean"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "datatype", "value"], "properties": {"kind": {"const": "literal"}, "datatype": {"const": "date"}, "value": {"type": "string", "format": "date"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "datatype", "value"], "properties": {"kind": {"const": "literal"}, "datatype": {"const": "datetime"}, "value": {"type": "string", "format": "date-time"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "datatype", "value"], "properties": {"kind": {"const": "literal"}, "datatype": {"const": "uri"}, "value": {"type": "string", "format": "uri"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "json"}, "value": {"type": ["object", "array"]}}}
  ]
}