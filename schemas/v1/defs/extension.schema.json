{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-sentinel.dev/schemas/v1/defs/extension.schema.json",
  "title": "Namespaced Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "schema_version", "data"],
  "properties": {
    "namespace": {"type": "string", "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "data": {"type": "object"}
  }
}