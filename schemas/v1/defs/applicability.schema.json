{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cyber-sentinel.dev/schemas/v1/defs/applicability.schema.json",
  "title":"Applicability",
  "type":"object",
  "additionalProperties":false,
  "properties":{
    "platform_ids":{"type":"array","items":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"},"uniqueItems":true},
    "product_ids":{"type":"array","items":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"},"uniqueItems":true},
    "provider_ids":{"type":"array","items":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"},"uniqueItems":true},
    "version_ids":{"type":"array","items":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"},"uniqueItems":true},
    "version_constraints":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["subject_id","version_scheme","expression"],"properties":{"subject_id":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"},"version_scheme":{"type":"string","enum":["semver","numeric","date","build","opaque","vendor-native"]},"expression":{"type":"string","minLength":1}}}},
    "valid_from":{"type":"string","format":"date-time"},
    "valid_to":{"type":"string","format":"date-time"},
    "explanatory_claim_ids":{"type":"array","items":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"},"uniqueItems":true}
  }
}
