{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cyber-sentinel.dev/schemas/v1/defs/alias.schema.json",
  "title":"Alias",
  "type":"object",
  "additionalProperties":false,
  "required":["value","kind","case_sensitive"],
  "properties":{
    "value":{"type":"string","minLength":1},
    "kind":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},
    "case_sensitive":{"type":"boolean"},
    "scope":{"type":"object","additionalProperties":false,"properties":{"namespace":{"type":"string","pattern":"^[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"},"entity_type":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"provider_id":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"}},"minProperties":1},
    "locale":{"type":"string","pattern":"^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "applicability":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/applicability.schema.json"}
  }
}
