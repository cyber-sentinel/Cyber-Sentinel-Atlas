{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cyber-sentinel.dev/schemas/v1/validation-record.schema.json",
  "title":"ValidationRecord",
  "allOf":[
    {"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/common-metadata.schema.json"},
    {"type":"object","required":["record_kind","namespace","canonical_key","target_id","validation_type","validator_type","ruleset","result","validated_at","findings"],"properties":{
      "record_kind":{"const":"validation"},
      "namespace":{"type":"string","const":"atlas.validation"},
      "canonical_key":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
      "target_id":{"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/canonical-id.schema.json"},
      "validation_type":{"type":"string","enum":["schema","registry","referential-integrity","provenance","semantic","cross-domain","human-review"]},
      "validator_type":{"type":"string","enum":["deterministic","human","source-comparison"]},
      "ruleset":{"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}},
      "result":{"type":"string","enum":["pass","warn","fail"]},
      "validated_at":{"type":"string","format":"date-time"},
      "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["severity","code","message"],"properties":{"severity":{"type":"string","enum":["info","warning","error"]},"code":{"type":"string","pattern":"^[A-Z0-9_-]+$"},"message":{"type":"string","minLength":1},"path":{"type":"string"}}}}
    }}
  ],
  "unevaluatedProperties":false
}
