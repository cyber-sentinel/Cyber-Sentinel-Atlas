{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cyber-sentinel.dev/schemas/v1/source.schema.json",
  "title":"SourceRecord",
  "allOf":[
    {"$ref":"https://cyber-sentinel.dev/schemas/v1/defs/common-metadata.schema.json"},
    {"type":"object","required":["record_kind","namespace","canonical_key","title","publisher","source_class","canonical_urls","official_status","license","redistribution","freshness_policy","change_detection_policy"],"properties":{
      "record_kind":{"const":"source"},
      "namespace":{"type":"string","pattern":"^[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"},
      "canonical_key":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
      "title":{"type":"string","minLength":1},
      "publisher":{"type":"string","minLength":1},
      "source_class":{"type":"string","enum":["tier-a-authoritative","tier-b-primary-engineering","tier-c-secondary-research","tier-d-community"]},
      "canonical_urls":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","format":"uri"}},
      "official_status":{"type":"string","enum":["official","official-project","primary-engineering","secondary-reference","community"]},
      "license":{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"type":"string","enum":["verified","restricted","unknown"]},"identifier":{"type":"string","minLength":1},"url":{"type":"string","format":"uri"}}},
      "redistribution":{"type":"object","additionalProperties":false,"required":["policy"],"properties":{"policy":{"type":"string","enum":["allowed","restricted","prohibited","unknown"]},"notes":{"type":"string"}}},
      "freshness_policy":{"type":"object","additionalProperties":false,"required":["expected_update_cadence","stale_after_days"],"properties":{"expected_update_cadence":{"type":"string","minLength":1},"stale_after_days":{"type":"integer","minimum":1}}},
      "change_detection_policy":{"type":"object","additionalProperties":false,"required":["strategy"],"properties":{"strategy":{"type":"string","enum":["version","etag","last-modified","checksum","content-diff","release-feed","manual"]},"notes":{"type":"string"}}}
    }}
  ],
  "unevaluatedProperties":false
}
