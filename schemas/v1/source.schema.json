{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-sentinel.dev/schemas/v1/source.schema.json",
  "title": "SourceRecord",
  "allOf": [
    {"$ref": "https://cyber-sentinel.dev/schemas/v1/defs/common-metadata.schema.json"},
    {"type": "object", "required": ["record_kind", "namespace", "canonical_key", "title", "publisher", "source_class", "canonical_urls", "official_status", "license", "redistribution", "freshness_policy", "change_detection_policy"], "properties": {
      "record_kind": {"const": "source"},
      "namespace": {"type": "string", "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"},
      "canonical_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "title": {"type": "string", "minLength": 1},
      "publisher": {"type": "string", "minLength": 1},
      "source_class": {"type": "string", "enum": ["tier-a-authoritative", "tier-b-primary-engineering", "tier-c-secondary-research", "tier-d-community"]},
      "canonical_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
      "official_status": {"type": "string", "enum": ["official", "project-official", "unofficial"]},
      "license": {"type": "object", "additionalProperties": false, "required": ["verification_status"], "properties": {"verification_status": {"type": "string", "enum": ["verified", "restricted", "unknown"]}, "name": {"type": "string"}, "url": {"type": "string", "format": "uri"}}},
      "redistribution": {"type": "string", "enum": ["allowed", "restricted", "prohibited", "unknown"]},
      "freshness_policy": {"type": "object", "additionalProperties": false, "required": ["strategy"], "properties": {"strategy": {"type": "string", "minLength": 1}, "expected_update_cadence": {"type": "string"}, "stale_after": {"type": "string"}}},
      "change_detection_policy": {"type": "object", "additionalProperties": false, "required": ["strategy"], "properties": {"strategy": {"type": "string", "minLength": 1}}}
    }}
  ],
  "unevaluatedProperties": false
}