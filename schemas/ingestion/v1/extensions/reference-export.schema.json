{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/extensions/reference-export.schema.json",
  "title": "ControlledReferenceExportArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ingestion_contract_version",
    "reference_export_contract_version",
    "reference_export_id",
    "source_id",
    "source_version",
    "export_type",
    "collection_method",
    "reference_environment",
    "collector",
    "collected_at",
    "scope",
    "artifact",
    "controls",
    "retention_mode",
    "fixture_only",
    "diagnostics"
  ],
  "properties": {
    "ingestion_contract_version": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/contract_version"
    },
    "reference_export_contract_version": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/semver"
    },
    "reference_export_id": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/artifact_id"
    },
    "source_id": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/canonical_id"
    },
    "source_version": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/source_version"
    },
    "export_type": {
      "type": "string",
      "enum": ["windows-event-provider-metadata", "sysmon-schema"]
    },
    "collection_method": {
      "type": "string",
      "enum": ["wevtutil-gp-ge", "windows-event-log-api", "sysmon-s-all"]
    },
    "reference_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "product", "version", "build", "architecture", "locale"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 1}
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "tool_publisher", "tool_version", "command_shape"],
      "properties": {
        "tool_name": {"type": "string", "minLength": 1},
        "tool_publisher": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "command_shape": {"type": "string", "minLength": 1},
        "binary_sha256": {
          "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/sha256_digest"
        },
        "distribution_uri": {"type": "string", "format": "uri", "minLength": 1},
        "signature_status": {"type": "string", "minLength": 1},
        "signer_subject": {"type": "string", "minLength": 1}
      }
    },
    "collected_at": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/date_time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "channels", "native_identifier_types"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "native_identifier_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "notes": {"type": "string"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "media_type", "encoding", "byte_length", "sha256", "blob_ref"],
      "properties": {
        "logical_name": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "encoding": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {
          "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/sha256_digest"
        },
        "blob_ref": {"type": "string", "pattern": "^blob:sha256-[a-f0-9]{64}$"}
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected_outside_atlas_core",
        "upstream_binary_executed_by_atlas_core",
        "immutable_after_ingest",
        "source_execution_isolated",
        "operator_review_required"
      ],
      "properties": {
        "collected_outside_atlas_core": {"const": true},
        "upstream_binary_executed_by_atlas_core": {"const": false},
        "immutable_after_ingest": {"const": true},
        "source_execution_isolated": {"const": true},
        "operator_review_required": {"const": true}
      }
    },
    "retention_mode": {
      "type": "string",
      "enum": ["full", "restricted", "digest-only", "transient"]
    },
    "fixture_only": {"type": "boolean"},
    "diagnostics": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/diagnostics"
    }
  }
}
