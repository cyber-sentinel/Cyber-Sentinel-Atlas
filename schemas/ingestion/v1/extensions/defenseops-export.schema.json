{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/extensions/defenseops-export.schema.json",
  "title": "DefenseOpsValidatedExport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ingestion_contract_version",
    "defenseops_export_contract_version",
    "export_id",
    "source_id",
    "repository",
    "commit_sha",
    "release_version",
    "generated_at",
    "records",
    "fixture_only",
    "export_digest"
  ],
  "properties": {
    "ingestion_contract_version": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/contract_version"
    },
    "defenseops_export_contract_version": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/semver"
    },
    "export_id": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/artifact_id"
    },
    "source_id": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/canonical_id"
    },
    "repository": {"const": "cyber-sentinel/Cyber-Sentinel-DefenseOps"},
    "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "release_version": {"type": "string", "minLength": 1},
    "generated_at": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/date_time"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_id",
          "content_type",
          "path",
          "content_sha256",
          "native_backend",
          "native_format",
          "source_refs",
          "validation",
          "applicability",
          "telemetry_requirements",
          "license"
        ],
        "properties": {
          "content_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "content_type": {"type": "string", "enum": ["detection", "hunt", "engineering", "response"]},
          "path": {"type": "string", "pattern": "^[^/].*", "minLength": 1},
          "content_sha256": {
            "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/sha256_digest"
          },
          "native_backend": {"type": "string", "minLength": 1},
          "native_format": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quality_level", "review_status", "validated_at"],
            "properties": {
              "quality_level": {"type": "string", "enum": ["Q0", "Q1", "Q2", "Q3", "Q4"]},
              "review_status": {"type": "string", "enum": ["unreviewed", "reviewed", "validated", "rejected"]},
              "validated_at": {
                "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/date_time"
              },
              "evidence_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platforms"],
            "properties": {
              "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "products": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "telemetry_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "record_or_signal"],
              "properties": {
                "provider": {"type": "string", "minLength": 1},
                "record_or_signal": {"type": "string", "minLength": 1},
                "atlas_ref": {
                  "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/canonical_id"
                }
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"type": "string", "enum": ["verified", "restricted", "unknown"]},
              "identifier": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"},
              "notes": {"type": "string"}
            }
          }
        }
      }
    },
    "fixture_only": {"type": "boolean"},
    "export_digest": {
      "$ref": "https://raw.githubusercontent.com/cyber-sentinel/Cyber-Sentinel-Atlas/main/schemas/ingestion/v1/defs/common.schema.json#/$defs/sha256_digest"
    }
  }
}
