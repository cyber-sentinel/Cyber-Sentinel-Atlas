  "decision_basis": [
    "Both candidates satisfy Atlas MVP latency targets at the validated 20,000-document scale.",
    "Tantivy is faster on most sparse lexical cases and materially smaller on disk.",
    "SQLite + FTS5 is operationally simpler for exact resolution, structured filtering, provider catalogs, numeric browsing, deterministic total ordering, local/offline packaging and rollback.",
    "The measured Tantivy performance headroom is not currently required by the Atlas MVP product budget.",
    "SQLite + FTS5 therefore minimizes current total product/runtime complexity while preserving an engine-neutral Search Projection Corpus and explicit revisit triggers."
  ],
  "revisit_triggers": [
    "Material production corpus growth that approaches the SQLite latency budget.",
    "Search artifact footprint becomes a material content-pack or distribution constraint.",
    "Required ranking or query features cannot be expressed safely or efficiently with FTS5.",
    "Incremental indexing or rebuild cost becomes operationally significant.",
    "Final Shared Core architecture materially favors native Tantivy integration.",
    "Concurrency or read-pattern requirements exceed the selected SQLite profile."
  ]
}
