{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cyber-Sentinel ATLAS",
  "version": "0.1.0",
  "identifier": "com.cybersentinel.atlas",
  "build": {
    "frontendDist": "www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cyber-Sentinel ATLAS — First Preview",
        "width": 1320,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": [
        {
          "identifier": "main-preview-commands",
          "description": "Restrict the local main webview to the fixed First Preview Shared Core command set accepted by ADR-0026.",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-core-status",
            "allow-search-records",
            "allow-get-record",
            "allow-expand-graph",
            "allow-pack-status",
            "allow-pack-update",
            "allow-pack-rollback"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; connect-src 'none'; img-src 'self' data:; font-src 'self'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false
  }
}
